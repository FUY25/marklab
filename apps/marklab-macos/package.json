    "y-sweet": "0.9.1",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
